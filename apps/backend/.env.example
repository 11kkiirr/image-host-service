# Example .env for the backend using SQLite
# Place this file at apps/backend/.env (remove the .example suffix)

# Application
APP_HOST=localhost
APP_PORT=8000
BASE_URL=http://localhost:8000

# Database (SQLite async via aiosqlite)
# SQLAlchemy engine is built as: {DATABASE_SYSTEM}+{DATABASE_DRIVER}
# Use a relative or absolute path for DATABASE_NAME. Examples:
#  - ./data/sql_app.db    (file-based DB in project)
#  - :memory:             (in-memory DB)
DATABASE_SYSTEM=sqlite
DATABASE_DRIVER=aiosqlite
DATABASE_NAME=./data/sql_app.db
# Not used for SQLite, but kept for compatibility with the config
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=
# SQLite doesn't use TCP port; set to 0 to avoid int() errors
DATABASE_PORT=0

# Security
SECRET_KEY=change-me-please
